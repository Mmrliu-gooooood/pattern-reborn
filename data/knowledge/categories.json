{
  "profiles": [
    {
      "id": "silhouette",
      "display_name_zh": "轮廓优先",
      "description_zh": "优先保留二值轮廓、镂空和边缘结构。",
      "parameters": {
        "threshold_mode": "otsu",
        "morphology_kernel": 3,
        "denoise_strength": 0,
        "palette_size": 2,
        "preserve_holes": true,
        "manual_region_required": false
      },
      "limitations_zh": "复杂背景、折痕或低对比边缘会降低提取完整性，需人工检查镂空区域。"
    },
    {
      "id": "flat_color",
      "display_name_zh": "平面设色",
      "description_zh": "优先分离色块并控制调色板数量。",
      "parameters": {
        "threshold_mode": "lab_kmeans",
        "morphology_kernel": 3,
        "denoise_strength": 1,
        "palette_size": 6,
        "preserve_holes": false,
        "manual_region_required": false
      },
      "limitations_zh": "渐变、褪色、阴影和印刷网点会混淆色块，提取结果需人工核对。"
    },
    {
      "id": "textile",
      "display_name_zh": "织物纹理",
      "description_zh": "在抑制织物噪声时尽量保留线迹和细部。",
      "parameters": {
        "threshold_mode": "adaptive",
        "morphology_kernel": 3,
        "denoise_strength": 2,
        "palette_size": 5,
        "preserve_holes": true,
        "manual_region_required": false
      },
      "limitations_zh": "经纬纹、毛边、反光和细密线迹可能互相干扰，提取无法保证还原每一根线。"
    },
    {
      "id": "artifact_photo",
      "display_name_zh": "器物照片",
      "description_zh": "以人工框选为起点，容忍曲面透视和局部高光。",
      "parameters": {
        "threshold_mode": "grabcut_box",
        "morphology_kernel": 3,
        "denoise_strength": 1,
        "palette_size": 4,
        "preserve_holes": false,
        "manual_region_required": true
      },
      "limitations_zh": "曲面、遮挡、镜面反射和透视变形会限制提取；该辅助流程不能恢复照片中不可见的几何。"
    }
