# Provider credentials are intentionally empty. Keep real values in an untracked .env.
SEEDREAM_API_KEY=
QWEN_API_KEY=

# Optional provider and model overrides (https URLs only). Leave empty to use config/providers.json.
SEEDREAM_BASE_URL=
SEEDREAM_MODEL=
QWEN_BASE_URL=
QWEN_MODEL=

# Optional OpenRouter image API and custom full-endpoint settings.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
